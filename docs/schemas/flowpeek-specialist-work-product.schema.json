{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpeek.local/schemas/flowpeek-specialist-work-product.schema.json",
  "title": "Flowpeek specialist work product",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "kind", "specialist", "provider", "subject", "question", "facts", "unknowns", "options", "recommendation", "limitations", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "flowpeek-specialist-work-product/v1" },
    "artifactId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "kind": { "enum": ["brainstorming", "research-development"] },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "skill"],
      "properties": {
        "name": { "enum": ["Fara", "Gama"] },
        "skill": { "enum": ["fara-brainstorming", "gama-research-development"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "runId"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "model": { "type": "string", "minLength": 1, "maxLength": 240 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevision", "workingTree", "graphVersion", "contextRefs"],
      "properties": {
        "sourceRevision": { "type": ["string", "null"], "maxLength": 240 },
        "workingTree": { "enum": ["clean", "dirty", "unknown"] },
        "graphVersion": { "type": ["integer", "null"], "minimum": 0 },
        "contextRefs": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^fp://local/" } }
      }
    },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "facts": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "unknowns": { "type": "array", "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "hypothesis", "evidence", "risks", "experiment", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "hypothesis": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "evidence": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
          "risks": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
          "experiment": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "status": { "enum": ["proposed", "supported", "falsified", "inconclusive", "rejected"] }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "optionId", "summary"],
      "properties": {
        "status": { "enum": ["experiment-required", "proposed", "rejected", "inconclusive"] },
        "optionId": { "type": ["string", "null"], "maxLength": 240 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
