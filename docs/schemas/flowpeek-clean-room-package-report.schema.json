{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowpeek.dev/schemas/flowpeek-clean-room-package-report.schema.json",
  "title": "Flowpeek Clean-Room Package Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "status", "evidenceClass", "environment", "packageAudit", "artifact", "phases", "smoke", "cleanup", "publication", "limitations"],
  "properties": {
    "schemaVersion": { "const": "flowpeek-clean-room-package-report/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed"] },
    "evidenceClass": { "const": "clean-room-package-observation" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "platform", "architecture", "lifecycleScriptsDuringInstall", "timingPolicy", "installWarningsPresent"],
      "properties": {
        "nodeVersion": { "type": "string" },
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "lifecycleScriptsDuringInstall": { "const": false },
        "timingPolicy": { "const": "host-specific-non-gating" },
        "installWarningsPresent": { "type": "boolean" }
      }
    },
    "packageAudit": { "type": "object" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256", "packedBytes"],
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packedBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "milliseconds"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed"] },
          "milliseconds": { "type": "number", "minimum": 0 },
          "code": { "type": "string" }
        }
      }
    },
    "smoke": { "type": "object" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "milliseconds"],
      "properties": { "status": { "enum": ["passed", "failed"] }, "milliseconds": { "type": "number", "minimum": 0 }, "code": { "type": "string" } }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "approved"],
      "properties": { "attempted": { "const": false }, "approved": { "const": false } }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
