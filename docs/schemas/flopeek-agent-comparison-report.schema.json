{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flopeek.dev/schemas/flopeek-agent-comparison-report.schema.json",
  "title": "Flopeek Agent Comparison Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "studyId", "suite", "status", "evidenceClass", "providerExecutionInvokedByFlopeek", "summary", "conclusionBoundary"],
  "properties": {
    "schemaVersion": { "const": "flopeek-agent-comparison-report/v1" },
    "studyId": { "type": "string", "minLength": 1 },
    "suite": { "type": "object", "required": ["id", "caseCount"], "properties": { "id": { "type": "string" }, "caseCount": { "type": "integer", "minimum": 1 }, "pairsMeasured": { "type": "integer", "minimum": 0 } } },
    "status": { "enum": ["not-run", "measured-from-supplied-provider-executions"] },
    "evidenceClass": { "enum": ["ai-provider-outcome", "ai-provider-outcome-with-committed-oracle"] },
    "providerExecutionInvokedByFlopeek": { "const": false },
    "summary": { "type": ["object", "null"] },
    "conclusionBoundary": { "type": "string", "minLength": 1 }
  }
}
