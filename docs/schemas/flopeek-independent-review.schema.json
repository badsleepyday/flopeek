{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flopeek.local/schemas/flopeek-independent-review.schema.json",
  "title": "Flopeek independent review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "reviewer", "provider", "subject", "scope", "evidence", "checks", "verdict", "limitations", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "flopeek-independent-review/v1" },
    "reviewId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "skill"],
      "properties": {
        "name": { "enum": ["Azka", "Bono", "Cuna", "Dana", "Elda", "Hadi", "Iris"] },
        "role": { "type": "string", "minLength": 1, "maxLength": 240 },
        "skill": { "enum": ["azka-flow-review", "bono-implementation-review", "cuna-system-flow-review", "dana-documentation-review", "elda-release-review", "hadi-automated-qa", "iris-manual-qa"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "runId", "independentExecution"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "model": { "type": "string", "minLength": 1, "maxLength": 240 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "independentExecution": { "type": "boolean" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "graphVersion", "contextRefs", "sourceRevision", "workingTree"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "graphVersion": { "type": "integer", "minimum": 0 },
        "contextRefs": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^fp://local/" } },
        "sourceRevision": { "type": ["string", "null"], "maxLength": 240 },
        "workingTree": { "enum": ["clean", "dirty", "unknown"] }
      }
    },
    "scope": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reference", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "kind": { "enum": ["context-ref", "parser-fact", "source", "test", "runtime-observation", "human-verification", "documentation", "screenshot", "review-artifact"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "finding", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "status": { "enum": ["passed", "failed", "unknown", "not-applicable"] },
          "finding": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "evidenceIds": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "summary"],
      "properties": {
        "status": { "enum": ["approved", "changes-required", "blocked", "inconclusive", "ineligible", "alpha", "beta", "stable"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
