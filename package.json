{
  "name": "flopeek",
  "version": "0.2.1-beta.3",
  "private": false,
  "license": "Apache-2.0",
  "description": "Versioned change context for developers and coding agents.",
  "keywords": [
    "code-intelligence",
    "developer-tools",
    "flow-graph",
    "mcp",
    "static-analysis"
  ],
  "homepage": "https://github.com/badsleepyday/flopeek#readme",
  "bugs": {
    "url": "https://github.com/badsleepyday/flopeek/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badsleepyday/flopeek.git"
  },
  "type": "commonjs",
  "bin": {
    "flopeek": "src/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "files": [
    "ARCHITECTURE.md",
    "BENCHMARKS.md",
    "PRODUCT.md",
    "ROADMAP.md",
    "SUPPORT.md",
    "benchmarks/agent-comparison-report.json",
    "benchmarks/agent-comparison-runs.template.json",
    "benchmarks/handoff-quality.json",
    "benchmarks/framework-entry-production-evidence.json",
    "benchmarks/production-static-evidence.json",
    "benchmarks/orientation-baseline.json",
    "benchmarks/orientation-cases.json",
    "benchmarks/orientation-flopeek.json",
    "benchmarks/private-dogfood-summary.json",
    "benchmarks/public-proof.json",
    "benchmarks/real-repository-corpus.json",
    "benchmarks/renderer-projection-corpus.json",
    "benchmarks/semantic-flow-suggestions.json",
    "benchmarks/semantic-suggestion-feedback-contract.json",
    "examples/commerce-showcase/",
    "docs/",
    "integrations/skills/flopeek/",
    "public/",
    "src/"
  ],
  "scripts": {
    "scan": "node src/cli.js scan .",
    "start": "node src/cli.js serve .",
    "test": "npm run test:full",
    "test:full": "node scripts/run-tests.js full",
    "test:fast": "node scripts/run-tests.js fast",
    "test:unit": "node scripts/run-tests.js unit",
    "test:adapters": "node --test test/scanner.test.js",
    "test:contracts": "node scripts/run-tests.js contracts",
    "test:viewer": "node scripts/run-tests.js viewer",
    "test:semantic": "node scripts/run-tests.js semantic",
    "test:feedback": "node scripts/run-tests.js feedback",
    "test:reviewed-evaluation": "node scripts/run-tests.js reviewed-evaluation",
    "test:trace": "node scripts/run-tests.js trace",
    "test:handoff-quality": "node --test test/unit/handoff-quality.test.js",
    "test:orientation": "node --test test/unit/orientation-benchmark.test.js",
    "test:agent-comparison": "node --test test/unit/agent-comparison.test.js",
    "test:package": "node scripts/run-tests.js package",
    "test:public-source": "node scripts/run-tests.js public-source",
    "test:clean-room": "node scripts/verify-clean-room.js",
    "test:showcase": "node scripts/run-tests.js showcase",
    "evaluate:handoff-quality": "node src/handoff-quality-benchmark.js",
    "evaluate:orientation": "node src/cli.js evaluate orientation . --cases benchmarks/orientation-cases.json",
    "evaluate:language-dogfood": "node src/supported-language-dogfood.js",
    "update:orientation-evidence": "node scripts/update-orientation-evidence.js",
    "audit:package": "node scripts/verify-package.js",
    "verify:clean-room": "node scripts/verify-clean-room.js",
    "verify:npm-publication": "node scripts/verify-npm-publication.js",
    "verify:github-release": "node scripts/verify-github-release.js",
    "update:clean-room-evidence": "node scripts/verify-clean-room.js --output packaging/evidence/clean-room-current.json",
    "evaluate:agent-comparison": "node src/cli.js evaluate agent-comparison . --cases benchmarks/orientation-cases.json --runs benchmarks/agent-comparison-runs.template.json",
    "showcase": "node src/cli.js showcase",
    "evaluate:semantic": "node src/semantic-suggestion-evaluation.js",
    "evaluate:feedback": "node src/semantic-suggestion-feedback-evaluation.js",
    "evaluate:reviewed-feedback": "node src/semantic-suggestion-reviewed-evaluation.js",
    "test:fixtures": "node --test test/fixture-corpus.test.js",
    "generate:support": "node scripts/generate-support.js",
    "generate:docs": "node scripts/generate-doc-assets.js",
    "check:docs": "node scripts/generate-doc-assets.js --check",
    "check:document-contracts": "node scripts/check-document-contracts.js",
    "verify:core-baseline": "node scripts/verify-core-baseline.js",
    "verify:native-js-parser-parity": "node scripts/compare-native-js-facts.js --require-exact",
    "update:core-baseline": "node scripts/verify-core-baseline.js --update",
    "test:docs": "node --test test/unit/documentation-assets.test.js",
    "check:support": "node scripts/generate-support.js --check",
    "benchmark": "node src/cli.js benchmark .",
    "benchmark:native-rust-shadow": "node scripts/benchmark-native-rust-shadow.js",
    "benchmark:native-incremental": "node scripts/benchmark-native-core-client.js",
    "benchmark:native-incremental-legacy": "node scripts/benchmark-native-incremental.js",
    "profile:native-incremental": "node scripts/profile-native-incremental.js",
    "test:real-corpus": "node src/real-repository-corpus.js",
    "qa:viewer-cancellation": "node scripts/viewer-cancellation-fixture.js",
    "prepublishOnly": "npm run verify:npm-publication"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  },
  "dependencies": {
    "@lezer/python": "^1.1.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "php-parser": "^3.7.0",
    "svelte": "^5.56.4",
    "tree-sitter": "^0.21.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-rust": "^0.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
